package pages

import (
  "strconv"
  "tradielynx/internal/models"
)

templ MyJobsPage(user models.LoggedUser, jobs []models.Job) {
  <section>
    <header class="container">
      <h1>My Jobs</h1>
      <p class="sub">Jobs you have posted on Tradielynx.</p>
    </header>

    <main class="jl-grid container">
      if len(jobs) == 0 {
        <div class="card body">
          <p>You haven't posted any jobs yet.</p>
          <a class="btn primary" href="/post-job">Post a Job</a>
        </div>
      }

      for _, job := range jobs {
        <a class="jl-card" href={ "/jobs/" + strconv.FormatInt(job.ID, 10) }>
          <div class="jl-meta">
            <div class="jl-row">
              <h2 class="jl-title-sm">{ job.Title }</h2>
              <span class="jl-pill">{ string(job.Status) }</span>
            </div>

            if job.BudgetMinMax != "" {
              <div class="jl-price">{ job.BudgetMinMax }</div>
            }

            <div class="jl-muted">📍 { job.PostCode }</div>
          </div>
        </a>
      }
    </main>
  </section>
}
