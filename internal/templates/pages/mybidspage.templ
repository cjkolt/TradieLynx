package pages

import (
  "strconv"
  "tradielynx/internal/models"
)

templ MyBidsPage(user models.LoggedUser, bids []models.Bid) {
  <section>
    <header class="container">
      <h1>My Bids</h1>
      <p class="sub">Bids you have submitted.</p>
    </header>

    <main class="jl-grid container">
      if len(bids) == 0 {
        <div class="card body">
          <p>You haven't placed any bids yet.</p>
          <a class="btn primary" href="/job-listings">Find a Job</a>
        </div>
      }

      for _, bid := range bids {
        <a class="jl-card" href={ "/jobs/" + strconv.FormatInt(bid.JobID, 10) }>
          <div class="jl-meta">
            <div class="jl-row">
              <h2 class="jl-title-sm">{ bid.JobTitle }</h2>
              <span class="jl-pill">{ string(bid.Status) }</span>
            </div>

            <div class="jl-price">{ bid.Amount }</div>

            if bid.Message != "" {
              <p class="jl-muted">{ bid.Message }</p>
            }
          </div>
        </a>
      }
    </main>
  </section>
}
