package pages

templ VerifWaitPage() {
  <section class="wrap">
    <div class="card">
      <header class="head">
        <h1>You're almost there.</h1>
      </header>
      <div class="body">
        <p>Your tradesperson account is waiting for admin verification.</p>
        <p class="muted">Once it is approved, you can log in and access job listings and bidding.</p>
        <div class="actions">
          <a class="btn" href="/login">Back to Login</a>
        </div>
      </div>
    </div>
  </section>
}
