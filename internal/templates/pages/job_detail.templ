package pages

import (
  "strconv"
  "tradielynx/internal/models"
)

templ JobDetailPage(user models.LoggedUser, job models.Job, bids []models.Bid) {
  <section class="wrap job-detail">
    <div class="card">
      <header class="head">
        <h1>{ job.Title }</h1>
        <span class="jl-pill">{ string(job.Status) }</span>
      </header>

      <div class="body">
        <p><strong>Location:</strong> { job.PostCode }</p>

        if job.PreferredTimeframe != "" {
          <p><strong>Preferred Timeframe:</strong> { job.PreferredTimeframe }</p>
        }

        if job.BudgetMinMax != "" {
          <p><strong>Budget Range:</strong> { job.BudgetMinMax }</p>
        }

        <h2>Description</h2>
        <p>{ job.Description }</p>

        if user.Role == models.RoleHomeowner && job.HomeownerID == user.ID {
          <div class="bid-list">
            <h2>Bids Received</h2>

            if len(bids) == 0 {
              <p class="muted">No bids have been submitted yet.</p>
            }

            for _, bid := range bids {
              <div class="bid-card">
                <div class="jl-row">
                  <strong>{ bid.TradespersonName }</strong>
                  <span class="jl-pill">{ string(bid.Status) }</span>
                </div>

                <p class="jl-price">{"$" + bid.Amount}</p>

                if bid.Message != "" {
                  <p>{ bid.Message }</p>
                }

                if job.Status == models.JobOpen && bid.Status == models.BidSubmitted {
                  <form method="POST" action="/bids/award">
                    <input type="hidden" name="job_id" value={ strconv.FormatInt(job.ID, 10) }/>
                    <input type="hidden" name="bid_id" value={ strconv.FormatInt(bid.ID, 10) }/>
                    <button class="btn primary" type="submit">Accept Bid</button>
                  </form>
                }
              </div>
            }
          </div>
        }

        if user.IsActive && user.Role == models.RoleTradesperson && job.Status == models.JobOpen {
          <div id="bid-section" class="bid-card">
            <button
              class="btn primary"
              hx-get={ "/bids/form?job_id=" + strconv.FormatInt(job.ID, 10) }
              hx-target="#bid-section"
              hx-swap="outerHTML">
              Place a Bid
            </button>
          </div>
        } else if user.Role == models.RoleTradesperson && !user.IsActive {
          <div class="bid-card">
            <p class="muted">Only verified tradespeople can place bids.</p>
          </div>
        }

        <div class="actions">
          <a class="btn" href="/job-listings">Back to jobs</a>
        </div>
      </div>
    </div>
  </section>
}
